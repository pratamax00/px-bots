# PX-Abuse — Account-Factory & Pool Operations Console
# Copy to a private vault (chmod 600) and never commit real credentials.

TG_TOKEN=123456789:REPLACE_WITH_BOT_TOKEN
OWNER_ID=123456789

# Account-Factory CLI executable and working directory
AF_BIN=/path/to/account-factory/.venv/bin/af
AF_ROOT=/path/to/account-factory

# Optional: Directory containing account_lists/farm/*/pending_cpa/xai-*.json
PENDING_CPA_ROOT=/path/to/auto-register

# Optional: Router .env (BASE_URL, INITIAL_PASSWORD) & backup dir for priority reordering
ROUTER_ENV_FILE=/path/to/router/.env
ROUTER_BACKUP_DIR=/path/to/router/backups

# Optional: Comma-separated custom email domains for domain-aware providers
GEN_DOMAINS=

# Local persistent state & background job logs
STATE_FILE=./state/px-abuse.json
JOBS_DIR=./state/px-abuse-jobs
