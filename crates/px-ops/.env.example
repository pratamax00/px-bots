# PX-Ops — Host Operations & Emergency Breakglass Console
# Copy to a private vault (chmod 600) and never commit real credentials.

TG_TOKEN=123456789:REPLACE_WITH_BOT_TOKEN
OWNER_ID=123456789

# External config directory (chmod 700) containing:
# services.json, backup-targets.json, thresholds.json, ops-forum.json
OPS_CONFIG_DIR=/path/to/px-ops/config

# Own systemd user unit name (excluded from self-crash alerts; uses safe delayed restart)
SELF_UNIT=px-ops.service

# Local persistent state, job logs, backups & diagnostics
STATE_FILE=./state/px-ops.json
JOBS_DIR=./state/px-ops-jobs
BACKUP_DIR=/path/to/backups/px-ops
DIAGNOSTICS_DIR=/path/to/diagnostics

# Optional: 9Router HTTP control & model catalog sync
NINE_ROUTER_BASE_URL=http://127.0.0.1:20128
NINE_ROUTER_API_KEY=
NINE_ROUTER_DATA_DIR=/path/to/9router/data

# Optional: Agent CLI & session mode/model management
HERMES_BIN=/path/to/hermes
HERMES_PROFILE_DIR=/path/to/agent/profiles/default
HERMES_PROFILES_ROOT=/path/to/agent/profiles
HERMES_CATALOG_PROFILES=default
